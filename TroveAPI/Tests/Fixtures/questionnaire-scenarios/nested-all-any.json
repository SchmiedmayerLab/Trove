        "items": [
          { "path": "Questionnaire.item[0]", "state": "enabled" },
          { "path": "Questionnaire.item[1]", "state": "disabled", "reason": "conditionsNotMet" },
          { "path": "Questionnaire.item[2]", "state": "enabled", "reason": "conditionsMet" },
          { "path": "Questionnaire.item[3]", "state": "enabled" },
          { "path": "Questionnaire.item[4]", "state": "enabled", "reason": "conditionsMet" },
          { "path": "Questionnaire.item[4].item[0]", "state": "enabled", "reason": "unconditional" },
          { "path": "Questionnaire.item[4].item[1]", "state": "enabled", "reason": "conditionsMet" },
          { "path": "Questionnaire.item[4].item[1].item[0]", "state": "enabled", "reason": "unconditional" },
          { "path": "Questionnaire.item[4].item[1].item[1]", "state": "disabled", "reason": "conditionsNotMet" }
        ],
        "response": [
          { "linkId": "symptoms", "answer": [{ "valueCoding": { "system": "http://example.org/symptoms", "code": "fever" } }] },
          { "linkId": "severity", "answer": [{ "valueInteger": 8 }] },
          {
            "linkId": "followup",
