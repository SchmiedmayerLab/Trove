        { "kind": "containment", "from": "Questionnaire.item[4].item[1]", "to": "Questionnaire.item[4].item[1].item[0]" },
        { "kind": "containment", "from": "Questionnaire.item[4].item[1]", "to": "Questionnaire.item[4].item[1].item[1]" },
        { "kind": "order", "from": "Questionnaire.item[0]", "to": "Questionnaire.item[1]" },
        { "kind": "order", "from": "Questionnaire.item[1]", "to": "Questionnaire.item[2]" },
        { "kind": "order", "from": "Questionnaire.item[2]", "to": "Questionnaire.item[3]" },
        { "kind": "order", "from": "Questionnaire.item[3]", "to": "Questionnaire.item[4]" },
        { "kind": "order", "from": "Questionnaire.item[4].item[0]", "to": "Questionnaire.item[4].item[1]" },
        { "kind": "order", "from": "Questionnaire.item[4].item[1].item[0]", "to": "Questionnaire.item[4].item[1].item[1]" },
        { "kind": "dependency", "from": "Questionnaire.item[0]", "to": "Questionnaire.item[1]" },
        { "kind": "dependency", "from": "Questionnaire.item[0]", "to": "Questionnaire.item[2]" },
        { "kind": "dependency", "from": "Questionnaire.item[0]", "to": "Questionnaire.item[4]", "condition": { "index": 0, "question": "symptoms" } },
        { "kind": "dependency", "from": "Questionnaire.item[3]", "to": "Questionnaire.item[4]", "condition": { "index": 1, "question": "severity", "operator": ">=", "answer": { "valueInteger": 7 } } },
        { "kind": "dependency", "from": "Questionnaire.item[3]", "to": "Questionnaire.item[4].item[1]", "condition": { "index": 0 } },
        { "kind": "dependency", "from": "Questionnaire.item[0]", "to": "Questionnaire.item[4].item[1]", "condition": { "index": 1, "operator": "exists" } },
        { "kind": "dependency", "from": "Questionnaire.item[0]", "to": "Questionnaire.item[4].item[1].item[1]" }
      ],
      "diagnostics": []
    },
    "scenarios": [
