            "answer": [
              { "valueCoding": { "system": "http://example.org/symptoms", "code": "cough" } },
              { "valueCoding": { "system": "http://example.org/symptoms", "code": "rash" } }
            ]
          },
          { "linkId": "severity", "answer": [{ "valueInteger": 3 }] }
        ],
        "diagnostics": [
          { "severity": "information", "rule": "answer-excluded", "path": "QuestionnaireResponse.item[2].item[0].answer[0]" },
          { "severity": "information", "rule": "answer-excluded", "path": "QuestionnaireResponse.item[2].item[1].item[0].answer[0]" }
        ]
      },
      {
        "name": "fever, severe",
