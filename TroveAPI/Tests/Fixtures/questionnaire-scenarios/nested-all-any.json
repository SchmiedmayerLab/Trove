{
  "evaluator": "trove-questionnaire-scenarios-1",
  "description": "Multiple answers, nested groups gated with any and all, disabled descendants, and changed earlier answers that recompute later items.",
  "questionnaire": {
    "resourceType": "Questionnaire",
    "url": "https://example.org/fhir/Questionnaire/scenario-nested",
    "version": "1.0.0",
    "status": "active",
    "language": "en-US",
    "item": [
      {
        "linkId": "symptoms", "type": "choice", "repeats": true, "text": "Symptoms",
        "answerOption": [
          { "valueCoding": { "system": "http://example.org/symptoms", "code": "cough" } },
          { "valueCoding": { "system": "http://example.org/symptoms", "code": "fever" } },
          { "valueCoding": { "system": "http://example.org/symptoms", "code": "rash" } }
        ]
      },
      {
        "linkId": "cough-detail", "type": "string", "text": "Describe the cough",
        "enableWhen": [{ "question": "symptoms", "operator": "=", "answerCoding": { "system": "http://example.org/symptoms", "code": "cough" } }]
      },
      {
        "linkId": "other-symptom", "type": "display", "text": "Another symptom than a cough",
        "enableWhen": [{ "question": "symptoms", "operator": "!=", "answerCoding": { "system": "http://example.org/symptoms", "code": "cough" } }]
      },
      { "linkId": "severity", "type": "integer", "text": "Severity from 0 to 10" },
      {
        "linkId": "followup", "type": "group", "text": "Follow-up", "enableBehavior": "any",
        "enableWhen": [
          { "question": "symptoms", "operator": "=", "answerCoding": { "system": "http://example.org/symptoms", "code": "fever" } },
          { "question": "severity", "operator": ">=", "answerInteger": 7 }
        ],
        "item": [
          { "linkId": "days", "type": "integer", "text": "Days with symptoms" },
          {
            "linkId": "detail", "type": "group", "text": "Details", "enableBehavior": "all",
            "enableWhen": [
              { "question": "severity", "operator": ">=", "answerInteger": 5 },
              { "question": "symptoms", "operator": "exists", "answerBoolean": true }
            ],
            "item": [
              { "linkId": "notes", "type": "string", "text": "Notes" },
              {
                "linkId": "rash-photo", "type": "display", "text": "Please photograph the rash",
                "enableWhen": [{ "question": "symptoms", "operator": "=", "answerCoding": { "system": "http://example.org/symptoms", "code": "rash" } }]
              }
            ]
          }
        ]
      }
    ]
  },
  "request": {
    "scenarios": [
      {
        "name": "cough and rash, mild",
        "item": [
          {
            "linkId": "symptoms",
            "answer": [
              { "valueCoding": { "system": "http://example.org/symptoms", "code": "cough" } },
              { "valueCoding": { "system": "http://example.org/symptoms", "code": "rash" } }
            ]
          },
          { "linkId": "severity", "answer": [{ "valueInteger": 3 }] },
          {
            "linkId": "followup",
            "item": [
              { "linkId": "days", "answer": [{ "valueInteger": 2 }] },
              { "linkId": "detail", "item": [{ "linkId": "notes", "answer": [{ "valueString": "Started at night" }] }] }
            ]
          }
        ]
      },
      {
        "name": "fever, severe",
        "item": [
          { "linkId": "symptoms", "answer": [{ "valueCoding": { "system": "http://example.org/symptoms", "code": "fever" } }] },
          { "linkId": "severity", "answer": [{ "valueInteger": 8 }] },
          {
            "linkId": "followup",
            "item": [
              { "linkId": "days", "answer": [{ "valueInteger": 2 }] },
              { "linkId": "detail", "item": [{ "linkId": "notes", "answer": [{ "valueString": "Started at night" }] }] }
            ]
          }
        ]
      },
      {
        "name": "only cough, severe",
        "item": [
          { "linkId": "symptoms", "answer": [{ "valueCoding": { "system": "http://example.org/symptoms", "code": "cough" } }] },
          { "linkId": "severity", "answer": [{ "valueInteger": 7 }] }
        ]
      }
    ]
  },
  "expected": {
