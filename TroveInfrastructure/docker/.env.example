# App
APP_ENVIRONMENT=development
LOG_LEVEL=info

# Authoritative PostgreSQL/Timescale Database
DATABASE_NAME=trove
DATABASE_USERNAME=trove_runtime
DATABASE_PASSWORD=synthetic-runtime-only
DATABASE_OPERATOR_USERNAME=trove_operator
DATABASE_OPERATOR_PASSWORD=synthetic-operator-only

# Keycloak
KEYCLOAK_REALM=trove
KEYCLOAK_ISSUER=http://localhost:8180/realms/trove
KEYCLOAK_API_AUDIENCE=trove-api
KEYCLOAK_CLIENT_ID=trove-server
KEYCLOAK_CLIENT_SECRET=dev-server-secret
KEYCLOAK_RESEARCHER_ROLE=trove-researcher
KEYCLOAK_PARTICIPANT_ROLE=trove-participant
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_DB_USERNAME=keycloak
KEYCLOAK_DB_PASSWORD=keycloak
KEYCLOAK_DB_NAME=keycloak

# Object Storage (SeaweedFS S3)
S3_ACCESS_KEY=admin
S3_SECRET_KEY=admin
S3_BUCKET=trove
S3_REGION=us-east-1

# Web
VITE_API_BASE_PATH=http://localhost:8080
VITE_KEYCLOAK_URL=http://localhost:8180
VITE_KEYCLOAK_REALM=trove
VITE_KEYCLOAK_CLIENT_ID=trove-web
