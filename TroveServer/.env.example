# Server
APP_ENVIRONMENT=development
LOG_LEVEL=info
# Set to the actual immutable deployment revision, never a client-supplied value.
# Omit for an unidentified local build; absence stays null in audit records.
# APPLICATION_REVISION=sha256:<reviewed-artifact-digest>

# Event admission fails closed when this private validator is not configured.
# Build the pinned image and use the isolated network overlay in TroveInfrastructure/validator.
# FHIR_VALIDATOR_URL=http://fhir-validator:8080/validate
# FHIR_VALIDATOR_IDENTITY=sha256:<manifest-digest-from-the-reviewed-validator-build>

# Optional absolute path to a PEM CA bundle, added to system trust for PostgreSQL,
# Keycloak, S3 and the validator. HTTPS and verified database TLS are required in
# production. There is no certificate-verification bypass. Restart after rotation.
# TLS_CA_FILE=/run/secrets/transport/ca.pem

# Production serving requires both PEM identity files (each at most 1 MiB).
# Database/operator commands do not require or receive the serving private key.
# Restart the server after renewal. Development may omit both files for HTTP.
# TLS_CERTIFICATE_FILE=/run/secrets/https/tls.crt
# TLS_PRIVATE_KEY_FILE=/run/secrets/https/tls.key

# Authoritative PostgreSQL/Timescale Database
DATABASE_NAME=trove
# Serving uses the restricted login provisioned by the infrastructure setup.
DATABASE_USERNAME=trove_runtime
DATABASE_PASSWORD=synthetic-runtime-only
DATABASE_PORT=5432
# Local development: localhost
# Docker development: host.docker.internal
DATABASE_HOST=localhost

# Keycloak
KEYCLOAK_REALM=trove
KEYCLOAK_ISSUER=http://localhost:8180/realms/trove
KEYCLOAK_API_AUDIENCE=trove-api
KEYCLOAK_CLIENT_ID=trove-server
KEYCLOAK_CLIENT_SECRET=dev-server-secret
KEYCLOAK_RESEARCHER_ROLE=trove-researcher
KEYCLOAK_PARTICIPANT_ROLE=trove-participant
# Local development: http://localhost:8180
# Docker development: http://host.docker.internal:8180
KEYCLOAK_URL=http://localhost:8180

# Object Storage (SeaweedFS S3)
# Local development: http://localhost:8333
# Docker development: http://host.docker.internal:8333
S3_ENDPOINT=http://localhost:8333
S3_ACCESS_KEY=admin
S3_SECRET_KEY=admin
S3_BUCKET=trove
S3_REGION=us-east-1
