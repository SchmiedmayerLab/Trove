meta {
  name: Create Questionnaire Component
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/studies/:studyId/components/questionnaire
  body: json
  auth: inherit
}

params:path {
  studyId: {{studyId}}
}

headers {
  If-Match: "{{draftRevision}}"
  Content-Type: application/json
}

body:json {
  {
    "name": "Daily Survey",
    "data": {
      "en-US": {
        "questionnaire": "{\"resourceType\":\"Questionnaire\",\"id\":\"daily-survey\",\"status\":\"active\",\"language\":\"en-US\",\"title\":\"Daily Survey\",\"item\":[{\"linkId\":\"q1\",\"text\":\"How are you feeling today?\",\"type\":\"string\"}],\"meta\":{\"profile\":[\"https://grovealliance.org/fhir/questionnaire/StructureDefinition/grove-questionnaire\"]},\"url\":\"https://example.org/fhir/Questionnaire/daily-survey\",\"version\":\"1.0.0\",\"extension\":[{\"url\":\"http://hl7.org/fhir/StructureDefinition/artifact-versionAlgorithm\",\"valueCoding\":{\"system\":\"http://hl7.org/fhir/version-algorithm\",\"code\":\"semver\"}}],\"subjectType\":[\"Patient\"]}"
      }
    }
  }
}

script:post-response {
  const body = res.getBody();
  bru.setVar("componentId", body.id);
  console.log("Component created with id: " + body.id);
}
