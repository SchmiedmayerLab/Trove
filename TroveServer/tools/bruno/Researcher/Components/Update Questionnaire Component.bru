meta {
  name: Update Questionnaire Component
  type: http
  seq: 9
}

put {
  url: {{baseUrl}}/studies/:studyId/components/questionnaire/:componentId
  body: json
  auth: inherit
}

params:path {
  studyId: {{studyId}}
  componentId: {{componentId}}
}

headers {
  If-Match: "{{draftRevision}}"
  Content-Type: application/json
}

body:json {
  {
    "name": "Daily Survey Updated",
    "data": {
      "en-US": {
        "questionnaire": "{\"resourceType\":\"Questionnaire\",\"id\":\"daily-survey\",\"status\":\"active\",\"language\":\"en-US\",\"title\":\"Daily Survey Updated\",\"item\":[{\"linkId\":\"q1\",\"text\":\"How are you feeling today?\",\"type\":\"string\"}],\"meta\":{\"profile\":[\"https://grovealliance.org/fhir/questionnaire/StructureDefinition/grove-questionnaire\"]},\"url\":\"https://example.org/fhir/Questionnaire/daily-survey\",\"version\":\"1.0.0\",\"extension\":[{\"url\":\"http://hl7.org/fhir/StructureDefinition/artifact-versionAlgorithm\",\"valueCoding\":{\"system\":\"http://hl7.org/fhir/version-algorithm\",\"code\":\"semver\"}}],\"subjectType\":[\"Patient\"]}"
      }
    }
  }
}
