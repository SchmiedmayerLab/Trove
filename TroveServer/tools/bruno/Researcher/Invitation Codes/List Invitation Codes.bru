meta {
  name: List Invitation Codes
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/studies/:studyId/invitation-codes
  body: none
  auth: inherit
}

params:path {
  studyId: {{studyId}}
}

script:post-response {
  const body = res.getBody();
  if (body && body.length > 0) {
    bru.setVar("invitationCodeId", body[0].id);
  }
}
