meta {
  name: List Schedules
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/studies/:studyId/components/:componentId/schedules
  body: none
  auth: inherit
}

params:path {
  studyId: {{studyId}}
  componentId: {{componentId}}
}

script:post-response {
  const body = res.getBody();
  if (body && body.length > 0) {
    bru.setVar("scheduleId", body[0].id);
  }
}
