meta {
  name: Create Study
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/groups/:groupId/studies
  body: json
  auth: inherit
}

params:path {
  groupId: {{groupId}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "title": "Simple Test Study",
    "icon": "tree-pine"
  }
}

script:post-response {
  const body = res.getBody();
  if (res.getStatus() !== 201 || typeof body.id !== "string" || typeof body.draftRevision !== "string") {
    throw new Error("Study creation did not return a draft identity");
  }
  bru.setVar("studyId", body.id);
  bru.setVar("draftRevision", body.draftRevision);
}
