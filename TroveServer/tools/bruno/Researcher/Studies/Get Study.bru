meta {
  name: Get Study
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/studies/:studyId
  body: none
  auth: inherit
}

params:path {
  studyId: {{studyId}}
}

script:post-response {
  if (res.getStatus() === 200) {
    const body = res.getBody();
    if (body.id !== bru.getVar("studyId") || typeof body.draftRevision !== "string") {
      throw new Error("Missing matching study draft revision");
    }
    bru.setVar("draftRevision", body.draftRevision);
  }
}
