meta {
  name: List Published Revisions
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/studies/:studyId/published
  body: none
  auth: inherit
}

params:path {
  studyId: {{studyId}}
}

script:post-response {
  const body = res.getBody();
  if (body && body.length > 0) {
    bru.setVar("publishedRevision", body[0].revision);
  }
}
