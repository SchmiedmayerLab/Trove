meta {
  name: List Study Enrollments
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/studies/:studyId/enrollments
  body: none
  auth: inherit
}

params:path {
  studyId: {{studyId}}
}

script:post-response {
  const body = res.getBody();
  if (body && body.length > 0) {
    bru.setVar("enrollmentId", body[0].id);
  }
}
