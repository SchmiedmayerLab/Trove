meta {
  name: Validate Study
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/studies/:studyId/draft/validations
  body: none
  auth: inherit
}

params:path {
  studyId: {{studyId}}
}

headers {
  If-Match: "{{draftRevision}}"
}

script:post-response {
  const body = res.getBody();
  if (res.getStatus() !== 201 || body.status !== "valid" || typeof body.candidate?.id !== "string" || body.draftRevision !== bru.getVar("draftRevision")) {
    throw new Error("Validation did not produce a candidate for the selected draft: " + JSON.stringify(body.blockers ?? []));
  }
  bru.setVar("validationId", body.candidate.id);
  bru.setVar("validatedDraftRevision", body.draftRevision);
  bru.setVar("validatedStudyId", bru.getVar("studyId"));
}
