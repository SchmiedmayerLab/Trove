{
  "name": "trove-web",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "description": "Trove web portal",
  "keywords": [
    "Trove",
    "Grove",
    "Web",
    "Study",
    "Platform",
    "Frontend"
  ],
  "engines": {
    "node": "24"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/SchmiedmayerLab/Trove"
  },
  "private": true,
  "scripts": {
    "dev": "vite --port 3000",
    "build": "tsc && vite build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:ci": "eslint --output-file eslint_report.json --format json .",
    "prepush": "npm run lint:fix && tsc --noEmit",
    "test": "vitest run",
    "generate:api": "openapi-ts",
    "postinstall": "openapi-ts",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:coverage": "COVERAGE=true playwright test; test_status=$?; nyc report --reporter=lcov --reporter=text-summary --report-dir coverage-e2e; coverage_status=$?; if [ \"$test_status\" -ne 0 ]; then exit \"$test_status\"; fi; exit \"$coverage_status\""
  },
  "dependencies": {
    "@hey-api/client-fetch": "^0.13.1",
    "@schmiedmayerlab/grove-design-system": "^0.1.1",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-router": "^1.160.2",
    "@tanstack/react-table": "^8.21.3",
    "@tiptap/extension-table": "^3.30.6",
    "@tiptap/pm": "^3.30.4",
    "@tiptap/react": "^3.30.4",
    "@tiptap/starter-kit": "^3.30.4",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "es-toolkit": "^1.44.0",
    "keycloak-js": "^26.2.3",
    "lucide-react": "^0.574.0",
    "match-sorter": "^8.2.0",
    "radix-ui": "^1.4.3",
    "react": "^19",
    "react-dom": "^19",
    "react-hotkeys-hook": "^5.2.4",
    "tailwind-merge": "^3.4.1",
    "tailwindcss": "^4.1.18",
    "tiptap-markdown": "^0.9.0",
    "usehooks-ts": "^3.1.1",
    "virtua": "^0.48.6",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.97.3",
    "@playwright/test": "^1.58.2",
    "@schmiedmayerlab/grove-configurations": "^0.1.1",
    "@tanstack/router-plugin": "^1.161.0",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/node": "^25",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.8.0",
    "nyc": "^18.0.0",
    "prettier": "^3",
    "typescript": "^5",
    "vite": "^7.3.2",
    "vite-plugin-istanbul": "^9.0.1",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "@hey-api/json-schema-ref-parser": {
      "js-yaml": "4.3.2"
    }
  }
}
