# App
APP_ENVIRONMENT=development
LOG_LEVEL=info

# Server Database
DATABASE_NAME=studyplatform
DATABASE_USERNAME=studyplatform
DATABASE_PASSWORD=studyplatform

# Timescale Database (time-series observations)
TIMESCALE_NAME=studyplatform
TIMESCALE_USERNAME=studyplatform
TIMESCALE_PASSWORD=studyplatform

# Keycloak
KEYCLOAK_REALM=studyplatform
KEYCLOAK_CLIENT_ID=studyplatform-server
KEYCLOAK_CLIENT_SECRET=dev-server-secret
KEYCLOAK_RESEARCHER_ROLE=studyplatform-researcher
KEYCLOAK_PARTICIPANT_ROLE=studyplatform-participant
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_DB_USERNAME=keycloak
KEYCLOAK_DB_PASSWORD=keycloak
KEYCLOAK_DB_NAME=keycloak

# Object Storage (SeaweedFS S3)
S3_ACCESS_KEY=admin
S3_SECRET_KEY=admin
S3_BUCKET=study-platform
S3_REGION=us-east-1

# Web
VITE_API_BASE_PATH=http://localhost:8080
VITE_KEYCLOAK_URL=http://localhost:8180
VITE_KEYCLOAK_REALM=studyplatform
VITE_KEYCLOAK_CLIENT_ID=studyplatform-web
