# Server
APP_ENVIRONMENT=development
LOG_LEVEL=info

# Server Database
DATABASE_NAME=studyplatform
DATABASE_USERNAME=studyplatform
DATABASE_PASSWORD=studyplatform
DATABASE_PORT=5432
# Local development: localhost
# Docker development: host.docker.internal
DATABASE_HOST=localhost

# Timescale Database (time-series observations)
TIMESCALE_NAME=studyplatform
TIMESCALE_USERNAME=studyplatform
TIMESCALE_PASSWORD=studyplatform
TIMESCALE_PORT=5433
# Local development: localhost
# Docker development: host.docker.internal
TIMESCALE_HOST=localhost

# Keycloak
KEYCLOAK_REALM=studyplatform
KEYCLOAK_CLIENT_ID=studyplatform-server
KEYCLOAK_CLIENT_SECRET=dev-server-secret
KEYCLOAK_RESEARCHER_ROLE=studyplatform-researcher
KEYCLOAK_PARTICIPANT_ROLE=studyplatform-participant
# Local development: http://localhost:8180
# Docker development: http://host.docker.internal:8180
KEYCLOAK_URL=http://localhost:8180

# Object Storage (SeaweedFS S3)
# Local development: http://localhost:8333
# Docker development: http://host.docker.internal:8333
S3_ENDPOINT=http://localhost:8333
S3_ACCESS_KEY=admin
S3_SECRET_KEY=admin
S3_BUCKET=study-platform
S3_REGION=us-east-1
